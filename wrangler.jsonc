{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daohangzhan",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "DATABASE_PROVIDER": "postgresql",
    "VITE_APP_URL": "https://www.viddir.com",
    "VITE_APP_NAME": "viddir",
    "VITE_APP_DESCRIPTION": "A directory of trending AI tools: what each tool does, how to use it, and where to find it.",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7f8a90bddcd04c6980232cb1fc7a34d1",
    },
  ],
}
